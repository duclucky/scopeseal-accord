# Secret signers used only by local deployment scripts. Never expose them to the frontend.
STUDIONET_PRIVATE_KEY=
# Optional project-specific override. An already-authorized parent integrator/delegate key is used when absent.
STUDIONET_CONTRACTOR_PRIVATE_KEY=

# Filled after a verified Studionet deployment.
GENLAYER_CONTRACT_ADDRESS=

# Public browser configuration.
VITE_CONTRACT_ADDRESS=
VITE_GENLAYER_IC_RPC_URL=https://studio.genlayer.com/api
VITE_GENLAYER_WALLET_CHAIN_ID=61999
VITE_GENLAYER_WALLET_CHAIN_NAME=GenLayer Studionet
VITE_GENLAYER_WALLET_RPC_URL=
VITE_GENLAYER_EXPLORER_URL=https://explorer-studio.genlayer.com
